<Window x:Class="CatalogBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ρυθμίσεις — Γέφυρα Καταλόγου"
        Height="620" Width="580" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,8"/>
            <Setter Property="Foreground" Value="#2A5788"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Σύνδεση Orexsys (Firebird)" Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Διακομιστής"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ServerBox" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Θύρα"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PortBox" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Αρχείο βάσης"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="DatabaseBox" Margin="0,4"/>
                    <Button    Grid.Row="2" Grid.Column="2" Content="..." Width="34" Margin="6,4,0,4"
                               Click="BrowseButton_Click"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Χρήστης"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="UserBox" Margin="0,4"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Κωδικός"
                               Style="{StaticResource FieldLabel}"/>
                    <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Margin="0,4"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Κωδικοσελίδα"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="CharsetCombo" Margin="0,4">
                        <ComboBoxItem Content="WIN1253"/>
                        <ComboBoxItem Content="UTF8"/>
                        <ComboBoxItem Content="ISO8859_7"/>
                    </ComboBox>
                </Grid>

                <TextBlock Text="Σύνδεση PointToOrder" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Διεύθυνση"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ApiUrlBox" Margin="0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Χρήστης"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ApiUserBox" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Κωδικός"
                               Style="{StaticResource FieldLabel}"/>
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ApiPasswordBox" Margin="0,4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Κωδικός καταστ."
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="ApiStoreBox" Margin="0,4"/>
                </Grid>

                <TextBlock Text="Τιμοκατάλογος" Style="{StaticResource SectionHeader}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Λίστα τιμών"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="PriceListCombo" Margin="0,4"
                               DisplayMemberPath="Label"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Τιμή προς σύγκριση"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="PriceSourceCombo" Margin="0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Κωδ. EFIC"
                               Style="{StaticResource FieldLabel}"
                               ToolTip="Ο κωδικός καταστήματος για νέες γραμμές EFIC (π.χ. PO11521)."/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="EficStoreBox" Margin="0,4"
                               ToolTip="Αφήστε κενό για αυτόματη ανάγνωση από τον πίνακα EFST. Σε νέα εγκατάσταση (κενό EFST) συμπληρώστε τον κωδικό που δίνει το PointToOrder, π.χ. PO11521."/>
                </Grid>

                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#5B6572" FontSize="12"
                           Text="Το Orexsys κρατά χωριστές τιμές delivery, take away και καταστήματος (πίνακας PRLD). Στις βάσεις που ελέγχθηκαν η τιμή καταστήματος είναι σχεδόν πάντα κενή, ενώ delivery και take away ταυτίζονται — γι' αυτό η προεπιλογή είναι «Delivery»."/>

                <TextBlock Text="Απόθεμα" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="StockSyncCheck" Margin="0,2"
                          Content="Αποστολή υπολοίπων (SCRB) στο PointToOrder κάθε 5 λεπτά"
                          ToolTip="Τα υπόλοιπα του ταμείου (πίνακας SCRB) στέλνονται ως stock στο PointToOrder όσο το πρόγραμμα είναι ανοιχτό. Προϊόντα χωρίς μετρητή δεν αγγίζονται."/>

                <TextBlock Text="Οθόνες τεχνικού" Style="{StaticResource SectionHeader}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#5B6572" FontSize="12"
                           Text="Ο απλός χρήστης βλέπει μόνο την «Αρχική» (κουμπί Συγχρονισμός). Οι παρακάτω οθόνες εμφανίζονται στο πλάι μόνο αν ενεργοποιηθούν εδώ."/>
                <CheckBox x:Name="ShowDashboardCheck" Content="Πίνακας ελέγχου" Margin="0,2"/>
                <CheckBox x:Name="ShowCompareCheck" Content="Σύγκριση καταλόγων" Margin="0,2"/>
                <CheckBox x:Name="ShowPushCheck" Content="Αποστολή προϊόντων" Margin="0,2"/>
                <CheckBox x:Name="ShowEficCheck" Content="Αντιστοιχίσεις" Margin="0,2"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="TestDbButton" Content="Έλεγχος βάσης" Padding="12,6" Margin="0,0,8,0"
                    Click="TestDbButton_Click"/>
            <Button x:Name="TestApiButton" Content="Έλεγχος API" Padding="12,6" Margin="0,0,8,0"
                    Click="TestApiButton_Click"/>
            <Button Content="Άκυρο" Padding="12,6" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Αποθήκευση" Padding="12,6" FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
