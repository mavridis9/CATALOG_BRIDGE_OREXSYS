<Window x:Class="CatalogBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Γέφυρα Καταλόγου — Orexsys / PointToOrder"
        Height="820" Width="1340" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#EEF0F7" Padding="16,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="10"
                                Width="38" Height="38">
                            <TextBlock Text="O" Foreground="White" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Orexsys" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="VersionText" Text="Γέφυρα PointToOrder" FontSize="11.5"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="ΠΛΟΗΓΗΣΗ" FontSize="10.5" FontWeight="SemiBold" Margin="14,0,0,8"
                               Foreground="#9AA0B2"/>

                    <RadioButton x:Name="SyncNav" Content="Αρχική" GroupName="Nav"
                                 Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="DashNav" Content="Πίνακας ελέγχου" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="CompareNav" Content="Σύγκριση καταλόγων" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="PushNav" Content="Αποστολή προϊόντων" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="EficNav" Content="Αντιστοιχίσεις" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="CustomersNav" Content="Πελάτες" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ΣΥΝΔΕΣΗ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9AA0B2"/>
                            <TextBlock x:Name="StoreInfoText" Text="—" FontSize="13" Margin="0,4,0,0"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="StockSyncText" Text="" FontSize="11.5" Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙  Ρυθμίσεις" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch" Click="SettingsButton_Click"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="26,22,26,22"/>
    </Grid>
</Window>
