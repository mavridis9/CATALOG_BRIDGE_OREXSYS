<Window x:Class="CatalogBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Γέφυρα Καταλόγου — Orexsys / PointToOrder"
        Height="860" Width="1400" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- The settings entry at the foot of the rail: looks like a rail item, acts like a button -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource RailInk}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Padding="12,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="20"
                                           Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource RailFaint}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource RailHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource RailHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A count next to a rail item (mismatches waiting for a look) -->
        <Style x:Key="RailBadge" TargetType="Border">
            <Setter Property="Background" Value="#E06A5A"/>
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="MinWidth" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The rail -->
        <Border Grid.Column="0" Background="{StaticResource RailBg}" Padding="14,22,14,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,28">
                        <Border Background="{StaticResource RailActive}" CornerRadius="8" Width="38" Height="38">
                            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#7FD3DE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Γέφυρα Καταλόγου" FontFamily="{StaticResource DisplayFont}" FontSize="15.5"
                                       FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="VersionText" Text="Orexsys ⇄ PointToOrder" FontSize="12"
                                       Foreground="{StaticResource RailFaint}"/>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="SyncNav" Content="Αρχική" Tag="&#xE80F;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="OrdersNav" Tag="&#xE715;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Αντιστοίχιση παραγγελιών" VerticalAlignment="Center"/>
                            <Border x:Name="OrdersBadge" Style="{StaticResource RailBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="OrdersBadgeText" Text="0" FontFamily="{StaticResource NumFont}" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CustomersNav" Content="Πελάτες" Tag="&#xE716;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>

                    <TextBlock x:Name="TechnicianLabel" Text="Για τον τεχνικό" FontSize="12" Margin="12,22,0,6"
                               Foreground="{StaticResource RailFaint}"/>
                    <RadioButton x:Name="DashNav" Content="Πίνακας ελέγχου" Tag="&#xE9D2;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="CompareNav" Content="Σύγκριση καταλόγων" Tag="&#xE8AB;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="PushNav" Content="Αποστολή προϊόντων" Tag="&#xE898;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="EficNav" Content="Αντιστοιχίσεις προϊόντων" Tag="&#xE71B;" GroupName="Nav"
                                 Style="{StaticResource NavItem}" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <!-- Where this installation points, the stock feed, the licence -->
                    <StackPanel Margin="12,0,8,14">
                        <TextBlock x:Name="StoreInfoText" Text="—" FontSize="12.5" Foreground="{StaticResource RailInk}"
                                   TextWrapping="Wrap" LineHeight="18"/>
                        <TextBlock x:Name="StockSyncText" Text="" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource RailFaint}" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="LicenceText" Text="" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource RailFaint}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Height="1" Background="#1E4A53" Margin="4,0,4,10"/>
                    <Button Content="Ρυθμίσεις" Style="{StaticResource RailButton}" Click="SettingsButton_Click"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="32,26,32,22"/>
    </Grid>
</Window>
