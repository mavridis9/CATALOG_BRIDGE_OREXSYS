<Window x:Class="CatalogBridge.PushPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Αποστολή στο PointToOrder — Έλεγχος πριν τη δημιουργία"
        Height="640" Width="860" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Πώς θα εμφανιστούν στο PointToOrder;" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="Το PointToOrder είναι αυτό που βλέπει ο πελάτης — διορθώστε τα ονόματα πριν σταλούν. Τίποτα δεν δημιουργείται μέχρι να πατήσετε «Αποστολή»."
                       FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- New categories -->
        <Border Grid.Row="1" x:Name="CategoriesCard" Style="{StaticResource Card}" Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Νέες κατηγορίες που θα δημιουργηθούν" FontSize="14"
                           FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Δώστε το όνομα που θα έχει η κάθε κατηγορία στο PointToOrder — π.χ. «OREXSYS», ή αφήστε το προτεινόμενο."
                           FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoriesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding OrexsysName}"
                                               VerticalAlignment="Center" MinWidth="200" FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="  →  " VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <TextBox Grid.Column="2" MaxWidth="360" HorizontalAlignment="Left"
                                             MinWidth="260" Style="{StaticResource SearchInput}"
                                             Padding="8,4"
                                             Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Products with editable display names -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="ProductsGrid" Style="{StaticResource ModernGrid}" IsReadOnly="False"
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Κωδικός" Binding="{Binding Code}" Width="105"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Όνομα στο Orexsys" Binding="{Binding OrexsysName}"
                                        Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="✏ Όνομα στο PointToOrder"
                                        Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*" IsReadOnly="False"/>
                    <DataGridTextColumn Header="Τιμή" Binding="{Binding PriceText}" Width="75"
                                        IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontSize="13"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" MinWidth="100"
                        Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button Content="Αποστολή" Style="{StaticResource PrimaryButton}" MinWidth="130"
                        Click="SendButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
