<UserControl x:Class="CatalogBridge.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,4,0,40">

            <!-- 0. Online orders: the till decides, PointToOrder is told (owner, 01/10/2026).
                 A status board, not a control panel: nothing here needs a click except the switch. -->
            <Border x:Name="MirrorCard" Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="MirrorDot" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,1,8,0">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="MirrorDotColor" Color="#C9CED9"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Online παραγγελίες" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"/>
                                <Border x:Name="MirrorCount" Style="{StaticResource Pill}" Padding="8,1" Margin="10,0,0,0"
                                        Background="{StaticResource WarnSoft}" Visibility="Collapsed">
                                    <TextBlock x:Name="MirrorCountText" Text="1" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="MirrorStateText" Text="Ανενεργό" FontSize="12.5" Margin="18,3,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="MirrorButton" Content="Ενεργοποίηση" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" MinWidth="150" Click="MirrorButton_Click"/>
                    </Grid>

                    <!-- One row per order still waiting; the pill says where it stands -->
                    <ItemsControl x:Name="WaitingList" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,0,8" Background="{StaticResource CardBg}"
                                        Style="{StaticResource EnterRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Token}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"/>
                                                <TextBlock Text="{Binding Who}" FontSize="14" Margin="10,0,0,0"
                                                           Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Items}" FontSize="13" Margin="0,3,0,0"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Hint}" FontSize="12.5" Margin="0,4,0,0"
                                                       Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="0,1,0,0">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="PillBg" Color="#EEF0FE"/>
                                            </Border.Background>
                                            <TextBlock x:Name="PillText" Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush x:Name="PillInk" Color="#4F46E5"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- The pill's colour follows the row's level with a short crossfade (200 ms, ease-out):
                                     0 waiting at the till · 1 take a look · 2 stuck · 3 accepted · 4 rejected -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard Duration="{StaticResource FadeDuration}">
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FCF1DF" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#B45309" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FCE8E6" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#C42B1C" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#E3F3E9" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#16803C" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="4">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FCE8E6" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#C42B1C" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Last line: what is going on, and today's tally -->
                    <Grid Margin="18,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MirrorStatusText" Grid.Column="0" Text="" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MirrorTodayText" Grid.Column="1" Text="" FontSize="12" Margin="16,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 1. Till orders → PointToOrder, automatic (owner request 22/09/2026; on top since 23/09) -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="TillSyncDot" Width="10" Height="10" CornerRadius="5" Background="#C9CED9"
                                    VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock Text="Παραγγελίες ταμείου → PointToOrder" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="TillSyncStateText" Text="Ανενεργό" FontSize="12.5" Margin="18,3,0,0"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TillSyncStatusText" Text="" FontSize="12" Margin="18,6,0,0"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="TillSyncButton" Content="Ενεργοποίηση" Style="{StaticResource SecondaryButton}"
                            VerticalAlignment="Center" MinWidth="150" Click="TillSyncButton_Click"/>
                </Grid>
            </Border>

            <!-- 2. The one button -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="24,26">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="32" Width="64" Height="64"
                            HorizontalAlignment="Center">
                        <TextBlock Text="⇄" FontSize="30" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Συγχρονισμός καταλόγου" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="Ο κατάλογος του Orexsys στέλνεται στο PointToOrder και τα δύο συστήματα μένουν πάντα ίδια."
                               FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"/>
                    <Button x:Name="SyncButton" Content="Συγχρονισμός" Style="{StaticResource PrimaryButton}"
                            FontSize="16" Padding="44,13" HorizontalAlignment="Center" Margin="0,20,0,0"
                            Click="SyncButton_Click"/>
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,14,0,0" Text="" MaxWidth="600"/>

                    <!-- Licence tripwire: red when expired / missing, amber in grace (License.Summary) -->
                    <Border x:Name="LicenceBanner" Visibility="Collapsed" CornerRadius="8" Padding="14,10" Margin="0,14,0,0"
                            HorizontalAlignment="Stretch" Background="#FDECEA">
                        <TextBlock x:Name="LicenceBannerText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="#C42B1C"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. Order mismatches: cancelled on one side, active on the other (owner, 23/09/2026) -->
            <Border x:Name="MismatchCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="MismatchDot" Width="10" Height="10" CornerRadius="5" Background="#C9CED9"
                                        VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Ασυμφωνίες παραγγελιών" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="MismatchStatusText" Text="Έλεγχος..." FontSize="12.5" Margin="18,3,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="MismatchCheckButton" Content="Έλεγχος τώρα" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" MinWidth="130" Click="MismatchCheckButton_Click"/>
                    </Grid>

                    <DataGrid x:Name="MismatchGrid" Style="{StaticResource ModernGrid}" Margin="0,10,0,0"
                              SelectionMode="Single" Visibility="Collapsed" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ημερομηνία" Binding="{Binding When, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                            <DataGridTextColumn Header="Αρ." Binding="{Binding Ref}" Width="65"/>
                            <DataGridTextColumn Header="Πελάτης" Binding="{Binding Customer}" Width="170"/>
                            <DataGridTextColumn Header="Ποσό" Binding="{Binding Total, StringFormat=0.00}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Πρόβλημα" Binding="{Binding Short}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C42B1C"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Action}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" Margin="4,2" FontSize="12.5" Click="MismatchFix_Click"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Per linked customer: the two sides' totals over the last 30 days, only where they differ -->
                    <TextBlock x:Name="CustomerTotalsHeader" Text="Σύνολα ανά πελάτη (τελευταίες 30 μέρες) — μόνο όσοι διαφέρουν"
                               FontSize="12.5" FontWeight="SemiBold" Margin="18,14,0,0" Visibility="Collapsed"
                               Foreground="{StaticResource InkBrush}"/>
                    <DataGrid x:Name="CustomerTotalsGrid" Style="{StaticResource ModernGrid}" Margin="0,6,0,0"
                              SelectionMode="Single" Visibility="Collapsed" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Πελάτης" Binding="{Binding Customer.Name}" Width="170"/>
                            <DataGridTextColumn Header="Orexsys" Binding="{Binding OrexsysText}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PointToOrder" Binding="{Binding PlatformText}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Διαφορά" Binding="{Binding DifferenceText}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#C42B1C"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Λεπτομέρειες" Binding="{Binding Details}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Παραγγελίες..." Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" Margin="4,2" FontSize="12.5" Click="CustomerTotalsOpen_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 4. What the last Συγχρονισμός did -->
            <Border x:Name="ResultsCard" Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="Collapsed" Padding="18,14">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Margin="2,4"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
