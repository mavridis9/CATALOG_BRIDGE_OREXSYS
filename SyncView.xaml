<UserControl x:Class="CatalogBridge.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A waiting order on the board: the whole row is the button that opens its ticket -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5F8F8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,0,40">

            <!-- The day, as the till sees it -->
            <TextBlock x:Name="TodayTitle" Text="Σήμερα" Style="{StaticResource ScreenTitle}"/>

            <!-- Licence tripwire: red when expired / missing, amber in grace (License.Summary) -->
            <Border x:Name="LicenceBanner" Visibility="Collapsed" CornerRadius="6" Padding="14,10" Margin="0,14,0,0"
                    Background="{StaticResource BadSoft}">
                <TextBlock x:Name="LicenceBannerText" FontSize="13.5" TextWrapping="Wrap" Foreground="{StaticResource BadBrush}"/>
            </Border>

            <!-- Online orders: the shop answers each one (ticket popup); the till gets it only if accepted -->
            <Border x:Name="MirrorCard" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18,22,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="MirrorDot" Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center" Margin="0,2,10,0">
                                    <Border.Background>
                                        <SolidColorBrush x:Name="MirrorDotColor" Color="#C7D2D4"/>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="Online παραγγελίες" Style="{StaticResource CardTitle}" FontSize="18"/>
                                <Border x:Name="MirrorCount" Style="{StaticResource Pill}" Padding="9,1" Margin="10,0,0,0"
                                        Background="{StaticResource WarnSoft}" Visibility="Collapsed">
                                    <TextBlock x:Name="MirrorCountText" Text="1" FontFamily="{StaticResource NumFont}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="MirrorStateText" Style="{StaticResource CardText}" Margin="19,6,0,0" Text=""/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="MirrorButton" Style="{StaticResource SwitchButton}" VerticalAlignment="Top"
                                Margin="0,4,0,0" Click="MirrorButton_Click" AutomationProperties.Name="Online παραγγελίες: έγκριση από εδώ"/>
                    </Grid>

                    <!-- Waiting orders; click one to open its ticket -->
                    <ItemsControl x:Name="WaitingList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource EnterRow}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                    <Button Style="{StaticResource RowButton}" Click="OpenTicket_Click" Margin="0,4"
                                            ToolTip="Άνοιγμα της παραγγελίας">
                                        <Grid Margin="6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Token}" FontFamily="{StaticResource NumFont}" FontSize="24" FontWeight="SemiBold"
                                                       FontStretch="SemiCondensed" Foreground="{StaticResource InkBrush}" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Margin="0,1,16,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" FontFamily="{StaticResource NumFont}"
                                                               FontSize="16" Foreground="{StaticResource InkBrush}" Margin="12,0,0,0"/>
                                                    <TextBlock Text="{Binding Customer}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding HowWhen}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Items}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Hint}" FontSize="12.5" Margin="0,4,0,0"
                                                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <Border.Background>
                                                    <SolidColorBrush x:Name="PillBg" Color="#E1EFF1"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding StateText}" FontSize="12.5" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush x:Name="PillInk" Color="#0F6170"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </Border>
                                <!-- The pill's colour follows the row's level with a short crossfade (200 ms, ease-out):
                                     0 waiting · 1 take a look · 2 stuck · 3 accepted · 4 rejected -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FBEFD9" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#A86400" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FBE6E3" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#B93A2E" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="3">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#E2F2E9" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#1F7A4D" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="4">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="PillBg" Storyboard.TargetProperty="Color" To="#FBE6E3" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                    <ColorAnimation Storyboard.TargetName="PillInk" Storyboard.TargetProperty="Color" To="#B93A2E" Duration="{StaticResource FadeDuration}" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nothing waiting: say what will happen -->
                    <Border x:Name="WaitingEmpty" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,6"
                            Visibility="Collapsed">
                        <TextBlock FontSize="13.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Καμία παραγγελία σε αναμονή. Όταν έρθει μία, ανοίγει μπροστά σας μόνη της."/>
                    </Border>

                    <!-- Last line: what is going on, and today's tally -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MirrorStatusText" Grid.Column="0" Text="" FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="MirrorTodayText" Grid.Column="1" Text="" FontSize="12.5" Margin="16,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- The catalogue: one button keeps PointToOrder the same as Orexsys -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Width="44" Height="44" VerticalAlignment="Center">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="Κατάλογος" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}" Margin="0,3,0,0"
                                       Text="Τα νέα προϊόντα του Orexsys στέλνονται στο PointToOrder και όσα κλείσατε στο ταμείο κλείνουν και online. Οι τιμές δεν αλλάζουν."/>
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="SyncButton" Content="Συγχρονισμός" Style="{StaticResource PrimaryButton}"
                                FontSize="15" Padding="26,11" VerticalAlignment="Center" Click="SyncButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="60,10,0,0" Text="" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- What the last Συγχρονισμός did -->
            <Border x:Name="ResultsCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed" Padding="22,14">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13.5" Margin="0,4" LineHeight="20"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
