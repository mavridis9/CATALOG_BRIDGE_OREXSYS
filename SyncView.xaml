<UserControl x:Class="CatalogBridge.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,40,0,40">

            <Border Background="{StaticResource AccentSoft}" CornerRadius="40" Width="80" Height="80"
                    HorizontalAlignment="Center">
                <TextBlock Text="⇄" FontSize="36" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Συγχρονισμός καταλόγου" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                       Margin="0,18,0,6"/>
            <TextBlock Text="Ο κατάλογος του Orexsys στέλνεται στο PointToOrder και τα δύο συστήματα μένουν πάντα ίδια."
                       FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"/>

            <Button x:Name="SyncButton" Content="Συγχρονισμός" Style="{StaticResource PrimaryButton}"
                    FontSize="17" Padding="46,15" HorizontalAlignment="Center" Margin="0,26,0,0"
                    Click="SyncButton_Click"/>

            <TextBlock x:Name="StatusText" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,16,0,0" Text=""/>

            <Border x:Name="ResultsCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="Collapsed" MinWidth="520">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Margin="2,4"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
