<UserControl x:Class="CatalogBridge.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,40,0,40">

            <Border Background="{StaticResource AccentSoft}" CornerRadius="40" Width="80" Height="80"
                    HorizontalAlignment="Center">
                <TextBlock Text="⇄" FontSize="36" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Συγχρονισμός καταλόγου" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                       Margin="0,18,0,6"/>
            <TextBlock Text="Ο κατάλογος του Orexsys στέλνεται στο PointToOrder και τα δύο συστήματα μένουν πάντα ίδια."
                       FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"/>

            <Button x:Name="SyncButton" Content="Συγχρονισμός" Style="{StaticResource PrimaryButton}"
                    FontSize="17" Padding="46,15" HorizontalAlignment="Center" Margin="0,26,0,0"
                    Click="SyncButton_Click"/>

            <TextBlock x:Name="StatusText" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,16,0,0" Text=""/>

            <!-- Licence tripwire: red when expired / missing, amber in grace (License.Summary) -->
            <Border x:Name="LicenceBanner" Visibility="Collapsed" CornerRadius="8" Padding="14,10" Margin="0,16,0,0"
                    MinWidth="520" HorizontalAlignment="Center" Background="#FDECEA">
                <TextBlock x:Name="LicenceBannerText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#C42B1C"/>
            </Border>

            <!-- Till orders → PointToOrder, automatic (owner request 22/09/2026) -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0" MinWidth="520" Padding="16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Παραγγελίες ταμείου → PointToOrder" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="TillSyncStateText" Text="Ανενεργό" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="330"/>
                        </StackPanel>
                        <Button x:Name="TillSyncButton" Content="Ενεργοποίηση" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150"
                                Click="TillSyncButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="TillSyncStatusText" Text="" FontSize="12" Margin="0,8,0,0"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Order mismatches: cancelled on one side, active on the other (owner, 23/09/2026) -->
            <Border x:Name="MismatchCard" Style="{StaticResource Card}" Margin="0,20,0,0" MinWidth="520" MaxWidth="720" Padding="16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Ασυμφωνίες παραγγελιών" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}"/>
                            <TextBlock x:Name="MismatchStatusText" Text="Έλεγχος..." FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="440"/>
                        </StackPanel>
                        <Button x:Name="MismatchCheckButton" Content="Έλεγχος τώρα" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="130"
                                Click="MismatchCheckButton_Click"/>
                    </Grid>
                    <ItemsControl x:Name="MismatchList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1D4CF" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Problem}" FontSize="12.5" Margin="0,2,0,0"
                                                       Foreground="#C42B1C" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding Action}" Style="{StaticResource SecondaryButton}"
                                                VerticalAlignment="Center" MinWidth="170" Click="MismatchFix_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="ResultsCard" Style="{StaticResource Card}" Margin="0,20,0,0"
                    Visibility="Collapsed" MinWidth="520">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" Margin="2,4"
                                       Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
