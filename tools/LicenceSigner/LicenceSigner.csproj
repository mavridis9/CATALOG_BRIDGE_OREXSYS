<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sign-licence</AssemblyName>
    <RootNamespace>CatalogBridge.LicenceSigner</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- the same token code the app verifies with - never a copy -->
    <Compile Include="..\..\LicenseToken.cs" Link="LicenseToken.cs" />
  </ItemGroup>
</Project>
