<Window x:Class="CatalogBridge.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Κάρτα πελάτη" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBg}" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="HintText" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,12"
                   Foreground="{StaticResource MutedBrush}"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock Text="Αριθμός κάρτας" Foreground="{StaticResource InkBrush}"/>
                <TextBox x:Name="CardBox" Margin="0,5,0,0" Padding="6,4" MaxLength="50"/>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="#A63A22"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" MinWidth="95" Margin="0,0,10,0"
                    IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="Καταχώρηση" Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
