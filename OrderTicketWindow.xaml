<Window x:Class="CatalogBridge.OrderTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Νέα online παραγγελία"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="BadSolid" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource BadBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BadBrush}"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#9A2E24"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Perforation" TargetType="Line">
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="#C9D3D4"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeDashArray" Value="3 3"/>
            <Setter Property="Margin" Value="0,16"/>
        </Style>
    </Window.Resources>

    <!-- Room around the ticket for its shadow; the whole thing rises 12 px as it arrives -->
    <Grid x:Name="Root" Margin="26,22,26,30" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootY" Y="12"/>
        </Grid.RenderTransform>
        <Grid.Effect>
            <DropShadowEffect Color="#0F2F35" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.32"/>
        </Grid.Effect>
        <Grid.RowDefinitions>
            <RowDefinition Height="9"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The torn top edge of a printed ticket (teeth drawn in code, to the window's width) -->
        <Path x:Name="Teeth" Grid.Row="0" Fill="{StaticResource TicketPaper}" Stretch="None" VerticalAlignment="Bottom"/>

        <Border Grid.Row="1" Background="{StaticResource TicketPaper}" CornerRadius="0,0,10,10" Padding="30,16,30,24">
            <StackPanel>
                <!-- Header: what this is, where it stands in the queue, close for now -->
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="LaterTopButton" Style="{StaticResource QuietButton}" Padding="8,4"
                            Margin="8,-4,-8,0" ToolTip="Αργότερα (Esc) — η παραγγελία μένει στην Αρχική" Click="Later_Click"
                            AutomationProperties.Name="Αργότερα">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    </Button>
                    <TextBlock DockPanel.Dock="Right" x:Name="QueueText" Text="" FontFamily="{StaticResource NumFont}" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="KindText" Text="Νέα online παραγγελία" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- The token: the one thing the kitchen and the customer both say out loud -->
                <TextBlock Text="{Binding Token}" FontFamily="{StaticResource NumFont}" FontSize="52" FontWeight="SemiBold"
                           FontStretch="SemiCondensed" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Customer}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,-2,0,0"/>
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding HowWhen}" FontSize="13.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding SubmittedText}" FontSize="13.5" Foreground="{StaticResource MutedBrush}"/>
                </WrapPanel>

                <Line Style="{StaticResource Perforation}"/>

                <!-- The items, like the printout -->
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding QtyText}" FontFamily="{StaticResource NumFont}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OptionsText}" FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontFamily="{StaticResource NumFont}" FontSize="16"
                                           Foreground="{StaticResource InkBrush}" Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="12,8" Margin="0,2,0,0"
                        Visibility="{Binding HasComment, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Comment}" FontSize="14" FontStyle="Italic" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                </Border>

                <Line Style="{StaticResource Perforation}"/>

                <DockPanel>
                    <TextBlock Text="Σύνολο" FontSize="14" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalText}" FontFamily="{StaticResource NumFont}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Decide -->
                <StackPanel x:Name="DecidePanel" Margin="0,18,0,0">
                    <TextBlock Text="Έτοιμη σε" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <UniformGrid x:Name="MinutesPanel" Rows="1" Margin="0,0,0,4"/>
                    <Button x:Name="AcceptButton" Style="{StaticResource GoodButton}" FontSize="17" Padding="0,14" Margin="0,8,0,0"
                            HorizontalAlignment="Stretch" IsEnabled="{Binding CanAccept}" Click="Accept_Click" Content="Αποδοχή"/>
                    <TextBlock Text="{Binding AcceptBlock}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" x:Name="AcceptHint"/>
                    <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                    <DockPanel Margin="0,12,0,0">
                        <Button Content="Αργότερα" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Click="Later_Click"/>
                        <Button Content="Απόρριψη..." Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanReject}" Click="RejectOpen_Click"/>
                    </DockPanel>
                </StackPanel>

                <!-- Reject: the reasons unfold inside the ticket; the customer reads the sentence shown -->
                <StackPanel x:Name="RejectPanel" Margin="0,18,0,0" Visibility="Collapsed">
                    <TextBlock Text="Γιατί απορρίπτεται;" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="Το μήνυμα το βλέπει ο πελάτης. Η απόρριψη δεν αναιρείται και η παραγγελία δεν φτάνει στο ταμείο."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <WrapPanel x:Name="ReasonsPanel"/>
                    <TextBox x:Name="OwnReasonBox" Margin="0,2,0,0" Visibility="Collapsed" MaxLength="400"
                             TextChanged="OwnReasonBox_TextChanged" AutomationProperties.Name="Δικός σας λόγος"/>
                    <Border Background="{StaticResource HoverBg}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
                        <TextBlock x:Name="ReasonPreview" FontSize="13" FontStyle="Italic" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="RejectErrorText" FontSize="13" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                    <DockPanel Margin="0,14,0,0">
                        <Button Content="Πίσω" Style="{StaticResource QuietButton}" DockPanel.Dock="Left" Click="RejectBack_Click"/>
                        <Button x:Name="RejectButton" Content="Απόρριψη παραγγελίας" Style="{StaticResource BadSolid}" HorizontalAlignment="Right"
                                Padding="22,11" FontSize="15" Click="Reject_Click"/>
                    </DockPanel>
                </StackPanel>

                <!-- Working / done -->
                <StackPanel x:Name="ResultPanel" Margin="0,22,0,4" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Border x:Name="ResultBadge" Width="52" Height="52" CornerRadius="26" Background="{StaticResource HoverBg}" HorizontalAlignment="Center">
                        <TextBlock x:Name="ResultIcon" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="ResultText" Text="" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock x:Name="ResultDetail" Text="" FontSize="13" Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
