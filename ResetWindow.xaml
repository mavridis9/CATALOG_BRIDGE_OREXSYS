<Window x:Class="CatalogBridge.ResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Επαναφορά από την αρχή"
        Height="640" Width="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBg}" FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Επαναφορά από την αρχή" FontSize="18" FontWeight="Bold"
                       Foreground="#A63A22"/>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                       Margin="0,4,0,0"
                       Text="Διαγράφει τα προϊόντα και τις κατηγορίες του PointToOrder και τις αντιστοιχίσεις (EFIC) του PointToOrder, ώστε όλα να σταλούν ξανά με τον Συγχρονισμό. Στο PointToOrder δεν υπάρχει αναίρεση — ο κατάλογος αποθηκεύεται πρώτα σε αρχείο (φάκελος backups), όπως και ο πίνακας EFIC."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <CheckBox x:Name="P2OCheck" IsChecked="True" FontSize="13.5" FontWeight="SemiBold"
                              Checked="Selection_Changed" Unchecked="Selection_Changed">
                        <TextBlock x:Name="P2OText" TextWrapping="Wrap" Text="PointToOrder: ανάγνωση..."/>
                    </CheckBox>

                    <TextBlock Text="Αντιστοιχίσεις EFIC" FontWeight="SemiBold" FontSize="13.5"
                               Margin="0,16,0,6" Foreground="{StaticResource InkBrush}"/>
                    <ItemsControl x:Name="CodeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanDelete}"
                                          Margin="0,3" FontSize="13" Checked="Selection_Changed" Unchecked="Selection_Changed">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{Binding LabelBrush}"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Πρόοδος" FontWeight="SemiBold" FontSize="13.5" Margin="0,16,0,6"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource MutedBrush}" Text="—"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource InkBrush}"
                       Text="Για επιβεβαίωση γράψτε ΔΙΑΓΡΑΦΗ:"/>
            <TextBox x:Name="ConfirmBox" Margin="0,4,0,0" Padding="6,4" FontSize="14"
                     TextChanged="ConfirmBox_TextChanged"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                       Margin="0,0,16,0" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloseButton" Content="Κλείσιμο" Style="{StaticResource SecondaryButton}"
                        MinWidth="100" Margin="0,0,10,0" Click="CloseButton_Click"/>
                <Button x:Name="ResetButton" Content="Διαγραφή όλων" Style="{StaticResource DangerButton}" FontWeight="SemiBold"
                        MinWidth="140" IsEnabled="False"
                        Click="ResetButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
