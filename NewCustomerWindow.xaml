<Window x:Class="CatalogBridge.NewCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Νέος πελάτης" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBg}" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Νέος πελάτης" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                       Text="Δημιουργείται στο Orexsys και στο PointToOrder με τα ίδια στοιχεία. Οι online παραγγελίες του θα τον βρίσκουν από το e-mail."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Ονοματεπώνυμο" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,5" Padding="6,4" MaxLength="50"/>

                <TextBlock Grid.Row="1" Text="Αριθμός κάρτας" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="CardBox" Margin="0,5" Padding="6,4" MaxLength="50"/>

                <TextBlock Grid.Row="2" Text="E-mail" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="EmailBox" Margin="0,5" Padding="6,4" MaxLength="50"/>

                <TextBlock Grid.Row="3" Text="Κινητό" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="MobileBox" Margin="0,5" Padding="6,4" MaxLength="20"/>

                <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Προαιρετικό. Μόνο ελληνικό κινητό (69xxxxxxxx) — το PointToOrder απορρίπτει παραγγελίες πελάτη με άλλο αριθμό. Αν μείνει κενό, μπαίνει αυτόματα ένας εσωτερικός αριθμός."/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" x:Name="ErrorText" TextWrapping="Wrap" Margin="2,10,0,0" FontSize="12.5"
                   Foreground="#A63A22"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" MinWidth="95" Margin="0,0,10,0"
                    IsCancel="True" Click="CancelButton_Click"/>
            <Button Content="Δημιουργία" Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True"
                    Click="CreateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
