<UserControl x:Class="CatalogBridge.PushView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Αποστολή προϊόντων" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Προϊόντα του Orexsys που δεν υπάρχουν ακόμα στο PointToOrder"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LoadButton" Content="Φόρτωση" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="LoadButton_Click"/>
                <Button x:Name="PushButton" Content="Αποστολή επιλεγμένων"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="PushButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="230" VerticalAlignment="Center"
                         Style="{StaticResource SearchInput}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Αναζήτηση προϊόντος"/>
                <Button x:Name="SelectAllButton" Content="Επιλογή όλων"
                        Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                        IsEnabled="False" Click="SelectAllButton_Click"/>
                <CheckBox x:Name="OnlyPricedCheck" Content="Μόνο με τιμή" Margin="18,0,0,0"
                          VerticalAlignment="Center" IsChecked="True" FontSize="13.5"
                          Foreground="{StaticResource InkBrush}"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"
                          ToolTip="Κρύβει τα προϊόντα χωρίς τιμή στον τιμοκατάλογο."/>
                <CheckBox x:Name="OnlyActiveCheck" Content="Μόνο ενεργά" Margin="14,0,0,0"
                          VerticalAlignment="Center" IsChecked="True" FontSize="13.5"
                          Foreground="{StaticResource InkBrush}"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                <CheckBox x:Name="MakeVisibleCheck" Content="Να γίνουν αμέσως ορατά στους πελάτες"
                          Margin="18,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                          Foreground="{StaticResource InkBrush}"
                          ToolTip="Τα νέα προϊόντα δημιουργούνται κρυφά. Με αυτό, γίνονται ορατά αμέσως."/>
            </StackPanel>
        </Border>

        <!-- Products card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="ProductsGrid" Style="{StaticResource ModernGrid}" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Κατηγορία" Binding="{Binding CategoryName}" Width="180"/>
                    <DataGridTextColumn Header="Κωδικός" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Τιμή" Binding="{Binding PriceText}" Width="85"/>
                    <DataGridTextColumn Header="Μεγέθη" Binding="{Binding SizesText}" Width="200"/>
                    <DataGridTextColumn Header="Κατάσταση POS" Binding="{Binding StateText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="2,12,0,0" FontSize="13"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Πατήστε «Φόρτωση» για να δείτε τα προϊόντα που δεν έχουν σταλεί."/>
    </Grid>
</UserControl>
