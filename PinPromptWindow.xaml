<Window x:Class="CatalogBridge.PinPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ρυθμίσεις" SizeToContent="Height" Width="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource AppBg}" FontFamily="Segoe UI">

    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="Κωδικός τεχνικού" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Οι ρυθμίσεις είναι μόνο για τον τεχνικό." FontSize="12.5"
                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                   Margin="0,4,0,14"/>

        <PasswordBox x:Name="PinBox" FontSize="20" Padding="10,7" HorizontalContentAlignment="Center"
                     MaxLength="8" KeyDown="PinBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" Text="" FontSize="12" Foreground="{StaticResource BadBrush}"
                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" MinWidth="100"
                    Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Είσοδος" Style="{StaticResource PrimaryButton}" MinWidth="100"
                    Click="OkButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
