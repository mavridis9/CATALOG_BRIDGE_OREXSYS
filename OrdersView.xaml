<UserControl x:Class="CatalogBridge.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        </Style>
    </UserControl.Resources>

    <!-- Everything that rides on matching online orders to Orexsys customers by e-mail (owner,
         01/10/2026: «everything that has to do with the e-mail correlation on its own panel»). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Stretch" Margin="0,0,0,40">

            <TextBlock Text="Αντιστοίχιση παραγγελιών" Style="{StaticResource ScreenTitle}"/>
            <TextBlock Style="{StaticResource ScreenLead}"
                       Text="Οι online παραγγελίες βρίσκουν τον πελάτη τους στο Orexsys από το e-mail του λογαριασμού του. Πάνω σε αυτή την αντιστοίχιση στηρίζονται η αποστολή των παραγγελιών του ταμείου στο PointToOrder και ο έλεγχος για ασυμφωνίες."/>

            <!-- The correlation itself: the trigger patch in Orexsys -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Αντιστοίχιση με το e-mail του πελάτη" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource CardText}" Margin="0,6,0,0"
                                       Text="Κάθε online παραγγελία πηγαίνει στον πελάτη του Orexsys που έχει το ίδιο e-mail με τον λογαριασμό του στο PointToOrder. Το τηλέφωνο δεν χρησιμοποιείται. Αν κανείς δεν έχει αυτό το e-mail, το Orexsys δημιουργεί νέο πελάτη."/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="EmailSwitch" Style="{StaticResource SwitchButton}" VerticalAlignment="Top"
                                Margin="0,2,0,0" Click="EmailSwitch_Click" AutomationProperties.Name="Αντιστοίχιση με e-mail"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="EmailStatePill" Style="{StaticResource Pill}" Background="{StaticResource HoverBg}">
                            <TextBlock x:Name="EmailStatePillText" Text="Έλεγχος..." FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="EmailStateText" Style="{StaticResource CardText}" Margin="12,0,12,0"
                                   VerticalAlignment="Center" Text=""/>
                        <Button Grid.Column="2" x:Name="RemoveEmailButton" Content="Αφαίρεση από το Orexsys..."
                                Style="{StaticResource DangerButton}" FontSize="13" Padding="12,6" Visibility="Collapsed"
                                Click="RemoveEmailButton_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource CardText}" FontSize="12.5" Margin="0,12,0,0" Foreground="{StaticResource FaintBrush}"
                               Text="Η αλλαγή γίνεται στο trigger EFOM_BIUD_TRG του Orexsys, με αντίγραφο ασφαλείας πρώτα, και ελέγχεται σε κάθε εκκίνηση. Χρειάζεται το Orexsys κλειστό σε όλους τους σταθμούς και τον κωδικό του τεχνικού."/>
                </StackPanel>
            </Border>

            <!-- Till orders → the customer's PointToOrder history -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Παραγγελίες ταμείου στο ιστορικό του πελάτη" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="TillSyncStateText" Style="{StaticResource CardText}" Margin="0,6,0,0" Text=""/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="TillSyncButton" Style="{StaticResource SwitchButton}" VerticalAlignment="Top"
                                Margin="0,2,0,0" Click="TillSyncButton_Click" AutomationProperties.Name="Παραγγελίες ταμείου στο PointToOrder"/>
                    </Grid>
                    <Border x:Name="TillNeedsEmail" Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <TextBlock FontSize="13" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                   Text="Χρειάζεται πρώτα την αντιστοίχιση με e-mail, αλλιώς οι παραγγελίες που στέλνονται θα ξαναγύριζαν στο ταμείο."/>
                    </Border>
                    <TextBlock x:Name="TillSyncStatusText" Style="{StaticResource CardText}" FontSize="12.5" Margin="0,10,0,0" Text=""/>
                    <TextBlock x:Name="TillSyncMessage" Style="{StaticResource CardText}" FontSize="12.5" Margin="0,6,0,0" Text=""
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Mismatches: cancelled on one side, active on the other; different amounts; never arrived -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ασυμφωνίες" Style="{StaticResource CardTitle}"/>
                                <Border x:Name="MismatchCount" Style="{StaticResource Pill}" Background="{StaticResource BadSoft}" Margin="10,0,0,0"
                                        Padding="9,1" Visibility="Collapsed">
                                    <TextBlock x:Name="MismatchCountText" Text="0" FontFamily="{StaticResource NumFont}" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{StaticResource BadBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardText}" Margin="0,6,0,0"
                                       Text="Κάθε 5 λεπτά συγκρίνονται οι παραγγελίες των τελευταίων 30 ημερών στα δύο συστήματα. Ό,τι δεν συμφωνεί φαίνεται εδώ, με τη διόρθωση όπου υπάρχει."/>
                            <TextBlock x:Name="MismatchStatusText" Style="{StaticResource CardText}" FontSize="12.5" Margin="0,8,0,0" Text="Έλεγχος..."/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="MismatchCheckButton" Content="Έλεγχος τώρα" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Top" Click="MismatchCheckButton_Click"/>
                    </Grid>

                    <DataGrid x:Name="MismatchGrid" Style="{StaticResource ModernGrid}" Margin="0,14,0,0"
                              SelectionMode="Single" Visibility="Collapsed" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ημερομηνία" Binding="{Binding When, StringFormat=dd/MM/yyyy HH:mm}" Width="128"/>
                            <DataGridTextColumn Header="Αρ." Binding="{Binding Ref}" Width="66">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource NumFont}"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Πελάτης" Binding="{Binding Customer}" Width="160"/>
                            <DataGridTextColumn Header="Ποσό" Binding="{Binding Total, StringFormat=0.00}" Width="66"
                                                ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Τι δεν συμφωνεί" Binding="{Binding Short}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Action}" Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" Margin="4,2" FontSize="12.5" Click="MismatchFix_Click"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Per linked customer: the two sides' totals over the last 30 days, only where they differ -->
                    <TextBlock x:Name="CustomerTotalsHeader" Text="Πελάτες με διαφορετικά σύνολα στα δύο συστήματα (30 μέρες)"
                               FontSize="13.5" FontWeight="SemiBold" Margin="0,20,0,0" Visibility="Collapsed"
                               Foreground="{StaticResource InkBrush}"/>
                    <DataGrid x:Name="CustomerTotalsGrid" Style="{StaticResource ModernGrid}" Margin="0,6,0,0"
                              SelectionMode="Single" Visibility="Collapsed" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Πελάτης" Binding="{Binding Customer.Name}" Width="160"/>
                            <DataGridTextColumn Header="Orexsys" Binding="{Binding OrexsysText}" Width="105" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="PointToOrder" Binding="{Binding PlatformText}" Width="105" ElementStyle="{StaticResource RightCell}"/>
                            <DataGridTextColumn Header="Διαφορά" Binding="{Binding DifferenceText}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Λεπτομέρειες" Binding="{Binding Details}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Παραγγελίες..." Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" Margin="4,2" FontSize="12.5" Click="CustomerTotalsOpen_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
