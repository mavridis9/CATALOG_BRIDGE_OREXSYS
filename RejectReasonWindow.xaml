<Window x:Class="CatalogBridge.RejectReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Απόρριψη παραγγελίας" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBg}" FontFamily="Segoe UI">
    <StackPanel Margin="22,18,22,18">
        <TextBlock x:Name="OrderText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="Γιατί απορρίπτεται; Το μήνυμα το βλέπει ο πελάτης." FontSize="13" Margin="0,12,0,6"
                   Foreground="{StaticResource MutedBrush}"/>
        <ComboBox x:Name="ReasonBox" IsEditable="True" FontSize="14" Padding="8,6" Height="Auto">
            <ComboBoxItem Content="Λυπούμαστε, δεν μπορούμε να εξυπηρετήσουμε την παραγγελία αυτή τη στιγμή."/>
            <ComboBoxItem Content="Κάποιο από τα προϊόντα έχει εξαντληθεί."/>
            <ComboBoxItem Content="Το κατάστημα είναι κλειστό."/>
            <ComboBoxItem Content="Δεν γίνεται διανομή σε αυτή την περιοχή."/>
            <ComboBoxItem Content="Έχουμε πολύ μεγάλη αναμονή — παρακαλούμε δοκιμάστε αργότερα."/>
        </ComboBox>
        <TextBlock Text="Η απόρριψη ΔΕΝ αναιρείται. Η παραγγελία φεύγει από τη λίστα και ο πελάτης ενημερώνεται."
                   FontSize="12" Margin="0,10,0,0" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Άκυρο" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True"/>
            <Button Content="Απόρριψη παραγγελίας" Style="{StaticResource DangerButton}" MinWidth="170" Margin="10,0,0,0"
                    Click="Reject_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
