<UserControl x:Class="CatalogBridge.EficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Αντιστοιχίσεις" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Ποιο προϊόν του Orexsys είναι ποιο στο PointToOrder (πίνακας EFIC)"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button x:Name="LoadButton" Content="Φόρτωση" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="LoadButton_Click"/>
        </Grid>

        <!-- Toolbar card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Εμφάνιση:" VerticalAlignment="Center" Margin="4,0,8,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="FilterCombo" Width="140" VerticalAlignment="Center"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="Όλες" IsSelected="True"/>
                    <ComboBoxItem Content="Σε extra"/>
                    <ComboBoxItem Content="Ορφανές"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" Width="220" Margin="14,0,0,0" VerticalAlignment="Center"
                         Style="{StaticResource SearchInput}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Αναζήτηση προϊόντος"/>
                <Border Width="1" Background="{StaticResource LineBrush}" Margin="16,2"/>
                <Button x:Name="RepairButton" Content="Αλλαγή προϊόντος Orexsys..."
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" IsEnabled="False"
                        Click="RepairButton_Click"
                        ToolTip="Δείχνει την επιλεγμένη αντιστοίχιση σε άλλο προϊόν Orexsys."/>
                <Button x:Name="DeleteButton" Content="Διαγραφή αντιστοίχισης"
                        Style="{StaticResource DangerButton}" IsEnabled="False"
                        Click="DeleteButton_Click"
                        ToolTip="Διαγράφει τις επιλεγμένες γραμμές EFIC. Δεν αγγίζει κανένα προϊόν."/>
            </StackPanel>
        </Border>

        <!-- Correlations card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="EficGrid" Style="{StaticResource ModernGrid}" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Κατάσταση" Binding="{Binding HealthText}" Width="105"/>
                    <DataGridTextColumn Header="Κωδ." Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="Προϊόν PointToOrder" Binding="{Binding PlatformText}" Width="*"/>
                    <DataGridTextColumn Header="Κωδ. Orexsys" Binding="{Binding OrexsysCode}" Width="115"/>
                    <DataGridTextColumn Header="Προϊόν Orexsys" Binding="{Binding OrexsysName}" Width="*"/>
                    <DataGridTextColumn Header="Μέγεθος" Binding="{Binding SizeText}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="Προϊόντα PointToOrder χωρίς αντιστοίχιση" FontSize="15"
                   FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="2,16,0,8"/>

        <!-- Unmapped platform offers card -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="UnmappedGrid" Grid.Column="0" Style="{StaticResource ModernGrid}"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Κωδ." Binding="{Binding OfferId}" Width="90"/>
                        <DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Κατηγορία" Binding="{Binding CategoryName}" Width="160"/>
                        <DataGridTextColumn Header="Τιμή" Binding="{Binding Price, StringFormat=0.00}" Width="75"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="MapButton" Grid.Column="1" Content="Αντιστοίχιση..."
                        Style="{StaticResource SecondaryButton}" Margin="10,4,4,0"
                        VerticalAlignment="Top" IsEnabled="False" Click="MapButton_Click"
                        ToolTip="Συνδέει το επιλεγμένο προϊόν PointToOrder με ένα προϊόν Orexsys."/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="2,12,0,0" FontSize="13"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Πατήστε «Φόρτωση» για να δείτε τις αντιστοιχίσεις."/>
    </Grid>
</UserControl>
