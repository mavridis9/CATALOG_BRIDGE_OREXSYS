<UserControl x:Class="CatalogBridge.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Πελάτες" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Ο πελάτης δημιουργείται μία φορά εδώ — στο Orexsys και στο PointToOrder — με την κάρτα και το e-mail του"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LoadButton" Content="Φόρτωση" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="LoadButton_Click"/>
                <Button x:Name="NewButton" Content="Νέος πελάτης" Style="{StaticResource PrimaryButton}"
                        Click="NewButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="240" VerticalAlignment="Center"
                         Style="{StaticResource SearchInput}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Αναζήτηση με όνομα, κάρτα ή e-mail"/>
                <Button x:Name="SendButton" Content="Αποστολή στο PointToOrder" IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Margin="14,0,0,0" Click="SendButton_Click"
                        ToolTip="Δημιουργεί στο PointToOrder τον επιλεγμένο πελάτη που υπάρχει μόνο στο Orexsys."/>
                <Button x:Name="InviteButton" Content="Αποστολή πρόσκλησης..." IsEnabled="False"
                        Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="InviteButton_Click"
                        ToolTip="Στέλνει στον επιλεγμένο πελάτη το e-mail του PointToOrder για να ορίσει κωδικό και να συνδεθεί. Δεν ανακαλείται."/>
            </StackPanel>
        </Border>

        <!-- Customers card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="CustomersGrid" Style="{StaticResource ModernGrid}" SelectionMode="Single"
                      SelectionChanged="CustomersGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Κατάσταση" Binding="{Binding LinkText}" Width="190"/>
                    <DataGridTextColumn Header="Όνομα" Binding="{Binding Name}" Width="*" MinWidth="140"/>
                    <DataGridTextColumn Header="Κάρτα" Binding="{Binding Card}" Width="110"/>
                    <DataGridTextColumn Header="" Binding="{Binding CardNote}" Width="110"/>
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn Header="Κινητό" Binding="{Binding Phone}" Width="110"/>
                    <DataGridTextColumn Header="Λογαριασμός PointToOrder" Binding="{Binding AccountText}" Width="190"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="2,12,0,0" FontSize="13"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Πατήστε «Φόρτωση» για να δείτε τους πελάτες, ή «Νέος πελάτης»."/>
    </Grid>
</UserControl>
