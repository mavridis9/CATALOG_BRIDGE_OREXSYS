<UserControl x:Class="CatalogBridge.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Σύγκριση καταλόγων" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>
                <TextBlock x:Name="CountText" Text="Τι διαφέρει ανάμεσα σε Orexsys και PointToOrder"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Content="Εξαγωγή CSV" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="ExportButton_Click" IsEnabled="False"/>
                <Button x:Name="CompareButton" Content="Σύγκριση" Style="{StaticResource PrimaryButton}"
                        Click="CompareButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Εμφάνιση:" VerticalAlignment="Center" Margin="4,0,8,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="FilterCombo" Width="210" VerticalAlignment="Center"
                          SelectionChanged="FilterCombo_SelectionChanged"/>

                <TextBox x:Name="SearchBox" Width="220" Margin="14,0,0,0" VerticalAlignment="Center"
                         Style="{StaticResource SearchInput}" TextChanged="SearchBox_TextChanged"
                         ToolTip="Αναζήτηση προϊόντος"/>

                <Border Style="{StaticResource Pill}" Background="{StaticResource GoodSoft}" Margin="16,0,8,0">
                    <TextBlock x:Name="OkPill" Text="—" Foreground="{StaticResource GoodBrush}" FontSize="12.5"/>
                </Border>
                <Border Style="{StaticResource Pill}" Background="{StaticResource WarnSoft}" Margin="0,0,8,0">
                    <TextBlock x:Name="PricePill" Text="—" Foreground="{StaticResource WarnBrush}" FontSize="12.5"/>
                </Border>
                <Border Style="{StaticResource Pill}" Background="{StaticResource BadSoft}">
                    <TextBlock x:Name="MissingPill" Text="—" Foreground="{StaticResource BadBrush}" FontSize="12.5"/>
                </Border>

                <Border Width="1" Background="{StaticResource LineBrush}" Margin="16,2"/>

                <Button x:Name="ActivateButton" Content="Ενεργοποίηση online"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="ActivateButton_Click" IsEnabled="False"
                        ToolTip="Κάνει τα επιλεγμένα προϊόντα ενεργά και ορατά στο PointToOrder."/>
                <Button x:Name="DeactivateButton" Content="Απενεργοποίηση online"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Click="DeactivateButton_Click" IsEnabled="False"
                        ToolTip="Κάνει τα επιλεγμένα προϊόντα ανενεργά και κρυφά στο PointToOrder."/>
            </StackPanel>
        </Border>

        <!-- Results card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="ResultsGrid" Style="{StaticResource ModernGrid}"
                      SelectionMode="Extended" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Κατάσταση" Binding="{Binding StatusText}" Width="160"/>
                    <DataGridTextColumn Header="Κατηγορία" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Orexsys" Binding="{Binding OrexsysName}" Width="*"/>
                    <DataGridTextColumn Header="PointToOrder" Binding="{Binding PlatformName}" Width="*"/>
                    <DataGridTextColumn Header="Τιμή POS" Binding="{Binding OrexsysPriceText}" Width="85"/>
                    <DataGridTextColumn Header="Τιμή online" Binding="{Binding PlatformPriceText}" Width="90"/>
                    <DataGridTextColumn Header="Online" Binding="{Binding PlatformStateText}" Width="115"/>
                    <DataGridTextColumn Header="Ταίριασμα" Binding="{Binding MatchedByText}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="2,12,0,0" FontSize="13"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Πατήστε «Σύγκριση» για να ξεκινήσετε."/>
    </Grid>
</UserControl>
